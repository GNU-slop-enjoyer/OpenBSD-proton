+static int read_symlink_reparse( int fd, void *buffer, size_t size )
+{
+    struct stat st;
+    ssize_t ret;
+
+    if (fstat( fd, &st ) == -1) return -1;
+    if (S_ISDIR(st.st_mode))
+    {
+        int data_fd = openat( fd, REPARSE_DIR_FILE, O_RDONLY | O_CLOEXEC | O_NOFOLLOW );
+
+        if (data_fd == -1) return -1;
+        ret = read_symlink_reparse( data_fd, buffer, size );
+        close( data_fd );
+        return ret;
+    }
+    if (!S_ISREG(st.st_mode) || st.st_size < 0 || st.st_size > size) goto invalid;
+    do ret = pread( fd, buffer, size, 0 ); while (ret == -1 && errno == EINTR);
+    if (ret == -1) return -1;
+    if (ret == st.st_size) return ret;
+invalid:
+    errno = EINVAL;
+    return -1;
+}
+#endif
