Proton's ntsync_tmp.h is a copy of a Linux uapi header (<linux/types.h>);
only include it on Linux.  Without it the server-based fallback is used.

Index: dlls/ntdll/unix/sync.c
--- dlls/ntdll/unix/sync.c.orig
+++ dlls/ntdll/unix/sync.c
@@ -61,7 +61,9 @@
 # include <sys/event.h>
 #endif
 
+#ifdef __linux__
 # include "ntsync_tmp.h"
+#endif
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
