Unix-side NtCurrentTeb() reads the TEB from the loader TLS slot instead of
%gs:0x30: OpenBSD has no user-settable %gs base and wine 11.0's Unix code
calls NtCurrentTeb() often, so it must not rely on the %gs fault-and-rewrite
path (fatal when first hit inside the SIGSEGV handler).
Also declare virtual_set_stack_mapping() and OpenBSD helpers.

Index: dlls/ntdll/unix/unix_private.h
--- dlls/ntdll/unix/unix_private.h.orig
+++ dlls/ntdll/unix/unix_private.h
@@ -29,6 +29,22 @@
 #include "wine/list.h"
 #include "wine/debug.h"
 
+#if defined(__OpenBSD__) && defined(__x86_64__)
+/* OpenBSD gives userland no way to set the %gs base; the TEB pointer lives
+ * in a TLS slot of the loader instead (see gs_openbsd.c).  Read it from
+ * there so that Unix code does not depend on the %gs fault-and-rewrite
+ * path, which must not trigger for the first time inside a signal handler. */
+extern long teb_tls_offset;
+static inline TEB *openbsd_current_teb(void)
+{
+    TEB *teb;
+
+    __asm__ volatile( "movq %%fs:(%1),%0" : "=r" (teb) : "r" (teb_tls_offset) );
+    return teb;
+}
+#define NtCurrentTeb() openbsd_current_teb()
+#endif
