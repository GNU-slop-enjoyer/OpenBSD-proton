libinotify installs sys/inotify.h outside the default include path.
Backport of the upstream Wine change adding INOTIFY_CFLAGS.

Index: dlls/winebus.sys/Makefile.in
--- dlls/winebus.sys/Makefile.in.orig
+++ dlls/winebus.sys/Makefile.in
@@ -2,7 +2,7 @@ MODULE    = winebus.sys
 UNIXLIB   = winebus.so
 IMPORTS   = ntoskrnl hidparse
 UNIX_LIBS    = $(IOKIT_LIBS) $(UDEV_LIBS) $(PTHREAD_LIBS) $(INOTIFY_LIBS)
-UNIX_CFLAGS  = $(UDEV_CFLAGS) $(SDL2_CFLAGS)
+UNIX_CFLAGS  = $(INOTIFY_CFLAGS) $(UDEV_CFLAGS) $(SDL2_CFLAGS)
 
 EXTRADLLFLAGS = -Wl,--subsystem,native
 
