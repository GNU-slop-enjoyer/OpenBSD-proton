+#if defined(HAVE_GETADDRINFO) && defined(HAVE_GETIFADDRS)
+
+/* whether node is this machine's host name, with or without the domain */
+static BOOL is_local_host_name( const char *node )
+{
+    char name[256];
+    size_t len;
+
+    if (!node || gethostname( name, sizeof(name) )) return FALSE;
+    name[sizeof(name) - 1] = 0;
+    if (!strcasecmp( node, name )) return TRUE;
+    len = strcspn( name, "." );
+    return strlen( node ) == len && !strncasecmp( node, name, len );
+}
+
+/* Windows always resolves its own host name (and "", which ws2_32 turns into
+ * it).  Hosts without nss-myhostname (OpenBSD and other BSDs) usually cannot,
+ * unless the name is in /etc/hosts.  Answer like nss-myhostname: with the
+ * addresses of the configured interfaces that are up (no loopback or IPv6
+ * link-local), or with localhost if there are none.  Each address is resolved
+ * numerically with the caller's hints and service; returns the number of
+ * result lists stored in lists. */
+static unsigned int getaddrinfo_local_host( const char *service, const struct addrinfo *hints,
+                                            struct addrinfo **lists )
+{
+    struct addrinfo numeric_hints = {0};
+    struct ifaddrs *ifaddrs, *ifa;
+    char addr[INET6_ADDRSTRLEN];
+    unsigned int count = 0;
+
+    if (hints) numeric_hints = *hints;
+    numeric_hints.ai_flags = (numeric_hints.ai_flags | AI_NUMERICHOST) & ~AI_CANONNAME;
+
+    if (!getifaddrs( &ifaddrs ))
+    {
+        for (ifa = ifaddrs; ifa && count < MAX_LOCAL_ADDRS; ifa = ifa->ifa_next)
+        {
+            int family = ifa->ifa_addr ? ifa->ifa_addr->sa_family : AF_UNSPEC;
+            const void *in;
+
+            if (!(ifa->ifa_flags & IFF_UP) || (ifa->ifa_flags & IFF_LOOPBACK)) continue;
+            if (family == AF_INET)
+                in = &((const struct sockaddr_in *)ifa->ifa_addr)->sin_addr;
+            else if (family == AF_INET6)
+            {
+                in = &((const struct sockaddr_in6 *)ifa->ifa_addr)->sin6_addr;
+                if (IN6_IS_ADDR_LINKLOCAL( (const struct in6_addr *)in )) continue;
+            }
+            else continue;
+            if (numeric_hints.ai_family != AF_UNSPEC && numeric_hints.ai_family != family) continue;
+            if (!inet_ntop( family, in, addr, sizeof(addr) )) continue;
+            if (!getaddrinfo( addr, service, &numeric_hints, &lists[count] )) count++;
+        }
+        freeifaddrs( ifaddrs );
+    }
+    if (!count && !getaddrinfo( "localhost", service, hints, &lists[0] )) count = 1;
+    return count;
+}
