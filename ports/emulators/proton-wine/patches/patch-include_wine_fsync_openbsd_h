+
+#ifndef __WINE_WINE_FSYNC_OPENBSD_H
+#define __WINE_WINE_FSYNC_OPENBSD_H
+
+#ifdef __OpenBSD__
+
+#include <limits.h>
+#include <stdint.h>
+#include <time.h>
+#include <sys/futex.h>
+
+#define FSYNC_WAITERS 255
+#define FSYNC_RESERVED_SLOTS (FSYNC_WAITERS + 1)
+
+struct fsync_waiter
+{
+    int      wake;   /* futex word the waiter sleeps on */
+    int      owner;  /* thread id of the waiter, 0 if free */
+    uint64_t mask;   /* buckets of the futexes it waits on */
+};
+
+static inline uint64_t fsync_futex_bucket( const void *addr )
+{
+    return (uint64_t)1 << (((uintptr_t)addr >> 4) & 63);
+}
+
+/* After changing the futex word at addr and FUTEX_WAKE on it: wake the
+ * threads waiting on it among others.  slot0 is the mapping of shm slot 0. */
+static inline void fsync_wake_waiters( int *slot0, const void *addr )
+{
+    struct fsync_waiter *waiters = (struct fsync_waiter *)(slot0 + 4);
+    uint64_t bit = fsync_futex_bucket( addr );
+    unsigned int i;
+
+    /* order the caller's store to the futex before reading the waiters;
+     * waiters register before reading the futex */
+    __atomic_thread_fence( __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &slot0[2], __ATOMIC_SEQ_CST ))
+    {
+        for (i = 0; i < FSYNC_WAITERS; i++)
+        {
+            if (!(__atomic_load_n( &waiters[i].mask, __ATOMIC_SEQ_CST ) & bit)) continue;
+            if (!__atomic_exchange_n( &waiters[i].wake, 1, __ATOMIC_SEQ_CST ))
+                futex( (volatile uint32_t *)&waiters[i].wake, FUTEX_WAKE, 1, NULL, NULL );
+        }
+    }
+    if (__atomic_load_n( &slot0[1], __ATOMIC_SEQ_CST ))
+    {
+        __atomic_add_fetch( &slot0[0], 1, __ATOMIC_SEQ_CST );
+        futex( (volatile uint32_t *)&slot0[0], FUTEX_WAKE, INT_MAX, NULL, NULL );
+    }
+}
+
+#endif /* __OpenBSD__ */
+#endif /* __WINE_WINE_FSYNC_OPENBSD_H */
