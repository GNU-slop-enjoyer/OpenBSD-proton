Directory change notifications: without /proc/self/fd or F_GETPATH
(OpenBSD) wineserver could not get a path for a watched directory, so it
never added an inotify (libinotify) watch and notifications never fired.
Use the Unix name the server opened the directory with (get_fd_unix_name()).

Index: server/change.c
--- server/change.c.orig
+++ server/change.c
@@ -667,22 +667,29 @@ static unsigned int filter_from_inode( s
     return filter;
 }
 
-static char *get_path_from_fd( int fd, int sz )
+static char *get_path_from_fd( struct fd *fd, int sz )
 {
 #ifdef linux
     char *ret = malloc( 32 + sz );
 
-    if (ret) snprintf( ret, 32 + sz, "/proc/self/fd/%u", fd );
+    if (ret) snprintf( ret, 32 + sz, "/proc/self/fd/%u", get_unix_fd( fd ) );
     return ret;
 #elif defined(F_GETPATH)
     char *ret = malloc( PATH_MAX + sz );
 
     if (!ret) return NULL;
-    if (!fcntl( fd, F_GETPATH, ret )) return ret;
+    if (!fcntl( get_unix_fd( fd ), F_GETPATH, ret )) return ret;
     free( ret );
     return NULL;
 #else
-    return NULL;
+    /* no way to ask the kernel (e.g. OpenBSD): use the name the server
+     * opened the directory with */
+    const char *name = get_fd_unix_name( fd );
+    char *ret;
+
+    if (!name || !(ret = malloc( strlen( name ) + 1 + sz ))) return NULL;
+    strcpy( ret, name );
+    return ret;
 #endif
 }
 
