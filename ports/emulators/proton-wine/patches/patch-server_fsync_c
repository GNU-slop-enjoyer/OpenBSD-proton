+#ifdef __OpenBSD__
+/* a thread that is killed while waiting on several futexes leaves its entry
+ * in the waiter table (wine/fsync_openbsd.h); the count of registered waiters
+ * is only a hint for wakers and stays as it is */
+void fsync_cleanup_thread_waiters( int unix_tid )
+{
+    struct fsync_waiter *waiters;
+    unsigned int i;
+
+    if (!is_fsync_initialized || unix_tid <= 0) return;
+    waiters = (struct fsync_waiter *)((int *)get_shm( 0 ) + 4);
+    for (i = 0; i < FSYNC_WAITERS; i++)
+    {
+        int owner = unix_tid;
+
+        if (__atomic_load_n( &waiters[i].owner, __ATOMIC_SEQ_CST ) != unix_tid) continue;
+        __atomic_store_n( &waiters[i].mask, 0, __ATOMIC_SEQ_CST );
+        __atomic_compare_exchange_n( &waiters[i].owner, &owner, 0, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+    }
+}
