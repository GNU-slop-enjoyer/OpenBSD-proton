+/* OpenBSD refuses connect() (EINVAL) on a TCP socket whose previous connect
+ * attempt failed, while Windows allows retrying on the same socket.  Replace
+ * the Unix socket with a new one at the same descriptor number, carrying over
+ * the file flags, the common options and the local address.  Only called for
+ * unconnected stream sockets, whose fd clients cannot have cached (see the
+ * allow_fd_caching() calls). */
+static int sock_recreate_unix_socket( struct sock *sock, int unix_fd, int new_family )
+{
+    static const int sol_options[] = { SO_REUSEADDR, SO_REUSEPORT, SO_KEEPALIVE, SO_OOBINLINE,
+                                       SO_DONTROUTE, SO_BROADCAST, SO_RCVBUF, SO_SNDBUF };
+    union unix_sockaddr addr;
+    socklen_t len = sizeof(addr);
+    struct linger linger;
+    int newfd, value, i, fl, fdfl, family;
+
+    if (new_family) family = new_family;
+    else if (sock->family == WS_AF_INET || sock->dualstack_v4) family = AF_INET;
+    else if (sock->family == WS_AF_INET6) family = AF_INET6;
+    else return -1;
+    /* may fail with EINVAL as well after the failed attempt */
+    if (getsockname( unix_fd, &addr.addr, &len )) addr.addr.sa_family = AF_UNSPEC;
+    if ((newfd = socket( family, SOCK_STREAM, IPPROTO_TCP )) == -1) return -1;
+
+    for (i = 0; i < ARRAY_SIZE(sol_options); i++)
+    {
+        socklen_t vlen = sizeof(value);
+        if (!getsockopt( unix_fd, SOL_SOCKET, sol_options[i], &value, &vlen ))
+            setsockopt( newfd, SOL_SOCKET, sol_options[i], &value, sizeof(value) );
+    }
+    len = sizeof(linger);
+    if (!getsockopt( unix_fd, SOL_SOCKET, SO_LINGER, &linger, &len ))
+        setsockopt( newfd, SOL_SOCKET, SO_LINGER, &linger, sizeof(linger) );
+    len = sizeof(value);
+    if (!getsockopt( unix_fd, IPPROTO_TCP, TCP_NODELAY, &value, &len ))
+        setsockopt( newfd, IPPROTO_TCP, TCP_NODELAY, &value, sizeof(value) );
+    if (family == AF_INET6 && addr.addr.sa_family == AF_INET6)
+    {
+        len = sizeof(value);
+        if (!getsockopt( unix_fd, IPPROTO_IPV6, IPV6_V6ONLY, &value, &len ))
+            setsockopt( newfd, IPPROTO_IPV6, IPV6_V6ONLY, &value, sizeof(value) );
+    }
+    fl = fcntl( unix_fd, F_GETFL );
+    fdfl = fcntl( unix_fd, F_GETFD );
+
+    /* the kqueue filters belong to the old socket; drop them while it exists,
+     * sock_reselect() adds them again for the new one */
+    set_fd_events( sock->fd, -1 );
+    if (dup2( newfd, unix_fd ) == -1)
+    {
+        close( newfd );
+        return -1;
+    }
+    close( newfd );
+    if (fl != -1) fcntl( unix_fd, F_SETFL, fl );
+    if (fdfl != -1) fcntl( unix_fd, F_SETFD, fdfl );
