+    if (family == AF_INET && addr.addr.sa_family == AF_INET6)
+    {
+        unsigned short port = addr.in6.sin6_port;
+
+        if (!port || !IN6_IS_ADDR_UNSPECIFIED( &addr.in6.sin6_addr )) addr.addr.sa_family = AF_UNSPEC;
+        else
+        {
+            memset( &addr.in, 0, sizeof(addr.in) );
+            addr.in.sin_len = sizeof(addr.in);
+            addr.in.sin_family = AF_INET;
+            addr.in.sin_port = port;
+            addr.in.sin_addr.s_addr = htonl( INADDR_ANY );
+        }
+    }
+
+    /* keep the local address (explicit, or chosen by the failed attempt) */
+    if ((addr.addr.sa_family == AF_INET && addr.in.sin_port) ||
+        (addr.addr.sa_family == AF_INET6 && addr.in6.sin6_port))
+    {
+        len = addr.addr.sa_family == AF_INET ? sizeof(addr.in) : sizeof(addr.in6);
+        bind( unix_fd, &addr.addr, len );
+    }
+    if (debug_level) fprintf( stderr, "socket %p: recreated (family %d)\n", sock, family );
+    return 0;
