+/* report an IPv4 address of a replaced dual-stack socket as IPv4-mapped IPv6 */
+static void sock_map_dualstack_addr( struct sock *sock, union unix_sockaddr *unix_addr )
+{
+    struct in_addr in;
+    unsigned short port;
+
+    if (!sock->dualstack_v4 || unix_addr->addr.sa_family != AF_INET) return;
+    in = unix_addr->in.sin_addr;
+    port = unix_addr->in.sin_port;
+    memset( &unix_addr->in6, 0, sizeof(unix_addr->in6) );
+    unix_addr->in6.sin6_len = sizeof(unix_addr->in6);
+    unix_addr->in6.sin6_family = AF_INET6;
+    unix_addr->in6.sin6_port = port;
+    unix_addr->in6.sin6_addr.s6_addr[10] = 0xff;
+    unix_addr->in6.sin6_addr.s6_addr[11] = 0xff;
+    memcpy( &unix_addr->in6.sin6_addr.s6_addr[12], &in, sizeof(in) );
+}
