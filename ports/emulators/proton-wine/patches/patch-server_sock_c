+/* OpenBSD has no IPv4-mapped addresses on IPv6 sockets (IPV6_V6ONLY cannot be
+ * turned off), so a dual-stack stream socket connecting to ::ffff:a.b.c.d gets
+ * an IPv4 Unix socket at the same descriptor (clients do not cache the fd of an
+ * unconnected stream socket); its addresses are reported back as IPv4-mapped.
+ * Dual-stack datagram and listening sockets are not emulated. */
+static int sock_connect_dualstack( struct sock *sock, int unix_fd, union unix_sockaddr *unix_addr,
+                                   socklen_t *unix_len )
+{
+    struct in_addr in;
+
+    if (!sock->dualstack || sock->dualstack_v4 || unix_addr->addr.sa_family != AF_INET6 ||
+        !IN6_IS_ADDR_V4MAPPED( &unix_addr->in6.sin6_addr ))
+        return 0;
+    if (sock_recreate_unix_socket( sock, unix_fd, AF_INET )) return -1;
+    sock->dualstack_v4 = 1;
+
+    memcpy( &in, &unix_addr->in6.sin6_addr.s6_addr[12], sizeof(in) );
+    unix_addr->in.sin_port = unix_addr->in6.sin6_port;  /* same offset in both */
+    memset( unix_addr->in.sin_zero, 0, sizeof(unix_addr->in.sin_zero) );
+    unix_addr->in.sin_addr = in;
+    unix_addr->in.sin_len = sizeof(unix_addr->in);
+    unix_addr->in.sin_family = AF_INET;
+    *unix_len = sizeof(unix_addr->in);
+    return 0;
+}
