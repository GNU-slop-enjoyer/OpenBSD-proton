LLVM lld does not know -Bsymbolic for PE targets (mingw-w64 uses it);
symbol binding inside a DLL is direct on Windows anyway.

Index: source/config/mh-mingw64
--- source/config/mh-mingw64.orig
+++ source/config/mh-mingw64
@@ -57,7 +57,7 @@
 #LINK.cc=      $(CXX) $(CXXFLAGS) $(LDFLAGS)
 
 ## Shared library options
-LD_SOOPTIONS= -Wl,-Bsymbolic
+LD_SOOPTIONS=
 
 ## Commands to make a shared library
 SHLIB.c=	$(CC) $(CFLAGS) $(LDFLAGS) -shared $(LD_SOOPTIONS) -Wl,--enable-auto-import -Wl,--out-implib=$(dir $@)lib$(notdir $(@:$(SO_TARGET_VERSION_MAJOR).$(SO)=))$(IMPORT_LIB_EXT)#M#
