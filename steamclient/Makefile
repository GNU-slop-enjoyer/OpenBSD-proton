# steamclient64.dll and steam.exe for proton-openbsd, built with a
# x86_64-w64-mingw32 C compiler (OpenBSD: devel/mingw-w64).
#
# ifaces.c is generated by gen.sh from Proton's lsteamclient sources and
# kept in the repository, so building needs only the compiler:
#	make gen LSTEAMCLIENT=/path/to/Proton/lsteamclient

# with mingw-w64 gcc instead: make MINGW_CC=x86_64-w64-mingw32-gcc \
#	MINGW_LDFLAGS=-static-libgcc
MINGW_CC ?=	x86_64-w64-mingw32-clang
MINGW_CFLAGS ?=	-O2
MINGW_LDFLAGS ?=
WCC =		${MINGW_CC}
WCFLAGS =	${MINGW_CFLAGS} -Wall -Wextra -Wno-unused-parameter
PREFIX ?=	/usr/local
DESTDIR ?=
LIBDIR =	${PREFIX}/lib/proton-steamclient

OBJS =		steamclient.o impl.o ifaces.o

all: steamclient64.dll steam.exe

.c.o:
	${WCC} ${WCFLAGS} -c $< -o $@

${OBJS}: steamclient.h

steamclient64.dll: ${OBJS}
	${WCC} -shared -o $@ ${OBJS} ${MINGW_LDFLAGS}

steam.exe: steam.c
	${WCC} ${WCFLAGS} -municode -o $@ steam.c ${MINGW_LDFLAGS}

gen:
	sh gen.sh ${LSTEAMCLIENT} > ifaces.c.new && mv ifaces.c.new ifaces.c

install: all
	install -d ${DESTDIR}${LIBDIR}
	install -m 644 steamclient64.dll steam.exe ${DESTDIR}${LIBDIR}

clean:
	rm -f ${OBJS} steamclient64.dll steam.exe

.PHONY: all gen install clean
