diff -ruN -x '*.orig' wine1119-base/include/wine/unixlib.h wine1119-new/include/wine/unixlib.h
--- a/include/wine/unixlib.h	2026-10-02 23:15:08.000000000 +0200
+++ b/include/wine/unixlib.h	2026-10-21 10:29:26.017621276 +0200
@@ -276,6 +276,20 @@
 #define wcstol(str,e,b)    ntdll_wcstol(str,e,b)
 #define wcstoul(str,e,b)   ntdll_wcstoul(str,e,b)
 
+/* Syscall arguments narrower than 32 bits (BOOLEAN, WORD, ...) reach the
+ * Unix side with the undefined upper bits the Windows caller left in the
+ * register or stack slot, as the x86_64 syscall dispatcher moves full
+ * 64-bit values.  Clang compiles SysV functions assuming such arguments
+ * were zero- or sign-extended to 32 bits by the caller (GCC does not), so
+ * e.g. a BOOLEAN FALSE can test as TRUE.  Making the argument opaque to
+ * the compiler at function entry forces it to use only the declared
+ * width. */
+#if defined(__x86_64__) && defined(__clang__)
+#define SYSCALL_NARROW_ARG(arg) __asm__( "" : "+r" (arg) )
+#else
+#define SYSCALL_NARROW_ARG(arg) do { } while (0)
+#endif
+
 #else /* WINE_UNIX_LIB */
 
 extern unixlib_handle_t __wine_unixlib_handle;
