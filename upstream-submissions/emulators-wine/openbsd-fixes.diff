+#ifdef __OpenBSD__
+/* OpenBSD refuses connect() (EINVAL) on a TCP socket whose previous connect
+ * attempt failed, while Windows allows retrying on the same socket.  Replace
+ * the Unix socket with a new one at the same descriptor number, carrying over
+ * the file flags, the common options and the local address.  Only called for
+ * unconnected stream sockets, whose fd clients cannot have cached (see the
+ * allow_fd_caching() calls). */
+static int sock_recreate_unix_socket( struct sock *sock, int unix_fd )
+{
+    static const int sol_options[] = { SO_REUSEADDR, SO_REUSEPORT, SO_KEEPALIVE, SO_OOBINLINE,
+                                       SO_DONTROUTE, SO_BROADCAST, SO_RCVBUF, SO_SNDBUF };
