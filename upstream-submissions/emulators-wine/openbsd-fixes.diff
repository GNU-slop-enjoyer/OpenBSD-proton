 }
 
+void claim_own_signal_targets( int tid )
+{
+    int saved_errno = errno;
+    unsigned int i;
+
+    if (!signal_targets || tid <= 0) return;
+
+    for (i = 0; i < SIGNAL_TARGETS_COUNT; i++)
+    {
+        uint64_t request = __atomic_load_n( &signal_targets[i], __ATOMIC_RELAXED );
+        unsigned int sig = request >> 32;
+
+        if (!request || (int)(uint32_t)request != tid) continue;
+        if (!__atomic_compare_exchange_n( &signal_targets[i], &request, 0, FALSE,
+                                          __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            continue;  /* the SIGUSR2 relay took it */
+        if (sig != SIGINT && sig != SIGUSR1 && sig != SIGQUIT) continue;
+        /* the caller blocks these signals; it is delivered when it unblocks them */
+        thrkill( tid, sig, NULL );
+    }
+    errno = saved_errno;
+}
+
 void init_signal_targets( const char *server_dir, unsigned int process_id )
 {
     void *ptr;
