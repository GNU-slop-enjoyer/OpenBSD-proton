+    if ((newfd = socket( family, SOCK_STREAM, IPPROTO_TCP )) == -1) return -1;
+
+    for (i = 0; i < ARRAY_SIZE(sol_options); i++)
+    {
+        socklen_t vlen = sizeof(value);
+        if (!getsockopt( unix_fd, SOL_SOCKET, sol_options[i], &value, &vlen ))
+            setsockopt( newfd, SOL_SOCKET, sol_options[i], &value, sizeof(value) );
+    }
+    len = sizeof(linger);
+    if (!getsockopt( unix_fd, SOL_SOCKET, SO_LINGER, &linger, &len ))
+        setsockopt( newfd, SOL_SOCKET, SO_LINGER, &linger, sizeof(linger) );
+    len = sizeof(value);
+    if (!getsockopt( unix_fd, IPPROTO_TCP, TCP_NODELAY, &value, &len ))
+        setsockopt( newfd, IPPROTO_TCP, TCP_NODELAY, &value, sizeof(value) );
+    if (family == AF_INET6)
