+    /* as ps(1) VSZ; p_vm_map_size is not filled in */
+    pvmi->VirtualSize = ((ULONG64)kp.p_vm_tsize + kp.p_vm_dsize + kp.p_vm_ssize) * page;
+    pvmi->PeakVirtualSize = pvmi->VirtualSize;
+    pvmi->WorkingSetSize = kp.p_vm_rssize * page;
+    /* ru_maxrss is in kilobytes */
+    pvmi->PeakWorkingSetSize = max( kp.p_uru_maxrss * 1024, pvmi->WorkingSetSize );
+    /* private memory: data (anonymous mappings included) and stack */
+    pvmi->PagefileUsage = ((ULONG64)kp.p_vm_dsize + kp.p_vm_ssize) * page;
+    pvmi->PeakPagefileUsage = pvmi->PagefileUsage;
+}
