+void fill_vm_counters( VM_COUNTERS_EX *pvmi, int unix_pid )
+{
+    int mib[] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, unix_pid == -1 ? getpid() : unix_pid,
+                  sizeof(struct kinfo_proc), 1 };
+    struct kinfo_proc kp;
+    size_t len = sizeof(kp);
+    ULONG64 page = getpagesize();
+
+    if (sysctl( mib, ARRAY_SIZE(mib), &kp, &len, NULL, 0 ) || len != sizeof(kp)) return;
