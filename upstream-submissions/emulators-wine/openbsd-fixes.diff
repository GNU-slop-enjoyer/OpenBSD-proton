+ *           find_gs_pad
+ *
+ * An instruction shorter than a jmp rel32 has room for a short jump (eb rel8).
+ * Look within its reach for int3 padding between functions to hold the
+ * jmp rel32 to the stub: a run of int3 right after a ret that ends where the
+ * next function starts (16-byte aligned).  Such padding is never executed,
+ * unlike int3 that follows a conditional jump (retguard traps).
+ * Returns the pad address or NULL.
+ */
+static BYTE *find_gs_pad( BYTE *site, unsigned int insn_len )
+{
+    BYTE buf[256 + JMP_REL32_LEN];
+    BYTE *next = site + JMP_REL8_LEN;  /* the rel8 is relative to this */
+    BYTE *start = next - 128;
