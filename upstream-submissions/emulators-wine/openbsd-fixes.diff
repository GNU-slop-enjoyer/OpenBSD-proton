+        len = sizeof(value);
+        if (!getsockopt( unix_fd, IPPROTO_IPV6, IPV6_V6ONLY, &value, &len ))
+            setsockopt( newfd, IPPROTO_IPV6, IPV6_V6ONLY, &value, sizeof(value) );
+    }
