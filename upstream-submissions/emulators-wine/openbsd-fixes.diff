 {
+    ULONG current;
+
     if (period < MMSYSTIME_MININTERVAL || period > MMSYSTIME_MAXINTERVAL)
         return TIMERR_NOCANDO;
 
     if (period > MMSYSTIME_MININTERVAL)
         WARN("Stub; we set our timer resolution at minimum\n");
 
