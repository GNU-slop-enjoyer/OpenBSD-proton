+#ifdef __OpenBSD__
+/* OpenBSD's IP_MULTICAST_TTL and IP_MULTICAST_LOOP are u_char options and
+ * setting them with any other length fails with EINVAL; Windows uses an int
+ * (or as many bytes as given). */
+static NTSTATUS do_getsockopt_uchar( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                     int option, void *out_buffer, ULONG out_size )
+{
+    NTSTATUS status;
+    unsigned char byte = 0;
+    int value;
+
+    if ((status = do_getsockopt( handle, NULL, level, option, &byte, sizeof(byte) )))
+        return status;
+    value = byte;
+    out_size = min( out_size, sizeof(value) );
+    memcpy( out_buffer, &value, out_size );
+    if (io)
+    {
+        io->Status = STATUS_SUCCESS;
+        io->Information = out_size;
+    }
+    return STATUS_SUCCESS;
+}
+#endif
