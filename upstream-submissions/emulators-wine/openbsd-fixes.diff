+/* Boolean options: BSD kernels return the option's flag bit (e.g. SO_OOBINLINE
+ * gives 0x100, TCP_NODELAY 4) where Windows and Linux return 1, and a short
+ * buffer would then truncate a set option to 0.  Read the full int and
+ * return 0 or 1 in as many bytes as requested. */
+static NTSTATUS do_getsockopt_bool( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                    int option, void *out_buffer, ULONG out_size )
+{
+    NTSTATUS status;
+    int value = 0;
+
+    if ((status = do_getsockopt( handle, NULL, level, option, &value, sizeof(value) )))
+        return status;
+    value = !!value;
