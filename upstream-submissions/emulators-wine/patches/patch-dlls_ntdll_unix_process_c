OpenBSD will kill any process that has %rsp outside of a MAP_STACK at syscall
or page fault. Upstream Wine doesn't mark its stacks.

Index: dlls/ntdll/unix/process.c
--- dlls/ntdll/unix/process.c.orig
+++ dlls/ntdll/unix/process.c
@@ -1066,6 +1066,34 @@ void fill_vm_counters( VM_COUNTERS_EX *p
     }
 }
 
+#elif defined(__OpenBSD__)
+
+void fill_vm_counters( VM_COUNTERS_EX *pvmi, int unix_pid )
+{
+    int mib[] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, unix_pid == -1 ? getpid() : unix_pid,
+                  sizeof(struct kinfo_proc), 1 };
+    struct kinfo_proc kp;
+    size_t len = sizeof(kp);
+    ULONG64 page = getpagesize();
+
+    if (sysctl( mib, ARRAY_SIZE(mib), &kp, &len, NULL, 0 ) || len != sizeof(kp)) return;
+
+    /* as ps(1) VSZ; p_vm_map_size is not filled in */
+    pvmi->VirtualSize = ((ULONG64)kp.p_vm_tsize + kp.p_vm_dsize + kp.p_vm_ssize) * page;
+    pvmi->PeakVirtualSize = pvmi->VirtualSize;
+    pvmi->WorkingSetSize = kp.p_vm_rssize * page;
+    /* ru_maxrss is in kilobytes */
+    pvmi->PeakWorkingSetSize = max( kp.p_uru_maxrss * 1024, pvmi->WorkingSetSize );
+    /* private memory: data (anonymous mappings included) and stack */
+    pvmi->PagefileUsage = ((ULONG64)kp.p_vm_dsize + kp.p_vm_ssize) * page;
+    pvmi->PeakPagefileUsage = pvmi->PagefileUsage;
+}
+
+int get_unix_debugger_pid(void)
+{
+    return 0;
+}
+
 #else
 
 void fill_vm_counters( VM_COUNTERS_EX *pvmi, int unix_pid )
@@ -1816,6 +1844,9 @@ NTSTATUS WINAPI NtSetInformationProcess(
                                        MEM_RESERVE, PAGE_READWRITE );
         if (!ret)
         {
+#ifdef __OpenBSD__
+            virtual_set_stack_mapping( addr, reserve );
+#endif
 #ifdef VALGRIND_STACK_REGISTER
