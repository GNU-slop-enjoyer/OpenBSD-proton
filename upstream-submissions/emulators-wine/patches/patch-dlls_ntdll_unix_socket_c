+/* Boolean options: BSD kernels return the option's flag bit (e.g. SO_OOBINLINE
+ * gives 0x100, TCP_NODELAY 4) where Windows and Linux return 1, and a short
+ * buffer would then truncate a set option to 0.  Read the full int and
+ * return 0 or 1 in as many bytes as requested. */
+static NTSTATUS do_getsockopt_bool( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                    int option, void *out_buffer, ULONG out_size )
+{
+    NTSTATUS status;
+    int value = 0;
+
+    if ((status = do_getsockopt( handle, NULL, level, option, &value, sizeof(value) )))
+        return status;
+    value = !!value;
+    out_size = min( out_size, sizeof(value) );
+    memcpy( out_buffer, &value, out_size );
+    if (io)
+    {
+        io->Status = STATUS_SUCCESS;
+        io->Information = out_size;
+    }
+    return STATUS_SUCCESS;
+}
+
+
+#ifdef __OpenBSD__
+/* OpenBSD's IP_MULTICAST_TTL and IP_MULTICAST_LOOP are u_char options and
+ * setting them with any other length fails with EINVAL; Windows uses an int
+ * (or as many bytes as given). */
+static NTSTATUS do_getsockopt_uchar( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                     int option, void *out_buffer, ULONG out_size )
+{
+    NTSTATUS status;
+    unsigned char byte = 0;
+    int value;
+
+    if ((status = do_getsockopt( handle, NULL, level, option, &byte, sizeof(byte) )))
+        return status;
+    value = byte;
+    out_size = min( out_size, sizeof(value) );
+    memcpy( out_buffer, &value, out_size );
+    if (io)
+    {
+        io->Status = STATUS_SUCCESS;
+        io->Information = out_size;
+    }
+    return STATUS_SUCCESS;
+}
+#endif
