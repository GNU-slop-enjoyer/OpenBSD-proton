+#ifdef __OpenBSD__
+static NTSTATUS do_setsockopt_uchar( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                     int option, const void *optval, socklen_t optlen )
+{
+    unsigned char byte;
+    int value = 0;
+
+    if (!optlen) return do_setsockopt( handle, io, level, option, optval, optlen );
+    memcpy( &value, optval, min( optlen, sizeof(value) ) );
+    if (value < 0 || value > 0xff) return STATUS_INVALID_PARAMETER;
+    byte = value;
+    return do_setsockopt( handle, io, level, option, &byte, sizeof(byte) );
+}
+#endif
