+#ifdef __OpenBSD__
+static BOOL use_precise_sleep(void);
+
+/* Server timeouts end on a clock tick (100 Hz), so a 1 ms wait takes 20 ms.
+ * In precise sleep mode (see use_precise_sleep) wait in the server only
+ * while more than two ticks remain, then poll the objects every 100 us and
+ * yield the CPU in between.  Only for waits that can be repeated (not
+ * signal-and-wait). */
+static unsigned int precise_server_wait( const union select_op *select_op, data_size_t size,
+                                         UINT flags, const LARGE_INTEGER *timeout )
+{
+    LARGE_INTEGER now, wait;
+    timeout_t when, next;
+    unsigned int ret;
+
+    if (!timeout || timeout->QuadPart == TIMEOUT_INFINITE || !timeout->QuadPart || !use_precise_sleep())
+        return server_wait( select_op, size, flags, timeout );
+
+    if ((when = timeout->QuadPart) < 0)
+    {
+        NtQuerySystemTime( &now );
+        when = now.QuadPart - when;
+    }
+    for (;;)
+    {
+        NtQuerySystemTime( &now );
+        if (when - now.QuadPart > 2 * TICKSPERSEC / 100)
+        {
+            wait.QuadPart = -(when - now.QuadPart - 2 * TICKSPERSEC / 100);
+            if ((ret = server_wait( select_op, size, flags, &wait )) != STATUS_TIMEOUT) return ret;
+            continue;
+        }
+        wait.QuadPart = 0;
+        if ((ret = server_wait( select_op, size, flags, &wait )) != STATUS_TIMEOUT) return ret;
+        next = now.QuadPart + TICKSPERSEC / 10000;
+        for (;;)
+        {
+            NtQuerySystemTime( &now );
+            if (now.QuadPart >= when) return STATUS_TIMEOUT;
+            if (now.QuadPart >= next) break;
+            sched_yield();
+        }
+    }
+}
+#else
+#define precise_server_wait server_wait
+#endif
+
