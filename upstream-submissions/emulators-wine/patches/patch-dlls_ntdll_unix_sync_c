+#ifdef __OpenBSD__
+/* resolution requested with NtSetTimerResolution(), in 100 ns units; 0 if none */
+static ULONG timer_resolution_request;
+
+/* OpenBSD's clock ticks at 100 Hz and sleeps end on a tick after the timeout,
+ * so Sleep(1) takes 20 ms and Sleep(16) 30 ms.  When the process asked for a
+ * finer timer resolution (timeBeginPeriod(1), as games with frame limiters
+ * do), or WINE_PRECISE_SLEEP=1 is set, sleep in the kernel only while more
+ * than two ticks remain and yield the CPU for the rest. */
+static BOOL use_precise_sleep(void)
+{
+    static int setting = -1;
+
+    if (setting == -1)
+    {
+        const char *env = getenv( "WINE_PRECISE_SLEEP" );
+        setting = env && *env ? !!atoi( env ) : 2;
+    }
+    if (setting != 2) return setting;
+    return timer_resolution_request && timer_resolution_request < 100000;
+}
+#endif
