+#ifdef __OpenBSD__
+/* Per-CPU time of the online CPUs, in 100ns units: user (user + nice),
+ * kernel (sys + spin + intr, plus idle as on Windows) and idle.  The
+ * counters come from kern.cpustats (sysctl(2) KERN_CPUSTATS) and tick at
+ * kern.clockrate's stathz.  Returns the number of CPUs filled in. */
+static unsigned int get_cpu_times( SYSTEM_PROCESSOR_PERFORMANCE_INFORMATION *times, unsigned int max )
+{
+    static int clockrate_name[] = { CTL_KERN, KERN_CLOCKRATE };
+    static int ncpu_name[] = { CTL_HW, HW_NCPU };
+    struct clockinfo clockrate;
+    struct cpustats stats;
+    unsigned int count = 0;
+    int i, ncpu;
+    size_t len;
+
+    len = sizeof(clockrate);
+    if (sysctl( clockrate_name, 2, &clockrate, &len, NULL, 0 ) || clockrate.stathz <= 0) return 0;
+    len = sizeof(ncpu);
+    if (sysctl( ncpu_name, 2, &ncpu, &len, NULL, 0 )) return 0;
+
+    for (i = 0; i < ncpu && count < max; i++)
+    {
+        int stats_name[] = { CTL_KERN, KERN_CPUSTATS, i };
+        const uint64_t *t = stats.cs_time;
+
+        len = sizeof(stats);
+        if (sysctl( stats_name, 3, &stats, &len, NULL, 0 )) continue;
+        if (!(stats.cs_flags & CPUSTATS_ONLINE)) continue;
+        times[count].IdleTime.QuadPart = t[CP_IDLE] * 10000000 / clockrate.stathz;
+        times[count].KernelTime.QuadPart = (t[CP_SYS] + t[CP_SPIN] + t[CP_INTR]) * 10000000 / clockrate.stathz +
+                                           times[count].IdleTime.QuadPart;
+        times[count].UserTime.QuadPart = (t[CP_USER] + t[CP_NICE]) * 10000000 / clockrate.stathz;
+        count++;
+    }
+    return count;
+}
+#endif
