Index: server/process.c
--- server/process.c.orig
+++ server/process.c
@@ -640,6 +640,9 @@ struct process *create_process( int fd,
     process->rawinput_device_count = 0;
     process->rawinput_mouse  = NULL;
     process->rawinput_kbd    = NULL;
+#ifdef __OpenBSD__
+    process->signal_targets  = NULL;
+#endif
     memset( &process->image_info, 0, sizeof(process->image_info) );
     list_init( &process->rawinput_entry );
     list_init( &process->kernel_object );
@@ -1439,7 +1442,13 @@ DECL_HANDLER(init_process_done)
 
     if (process->image_info.subsystem != IMAGE_SUBSYSTEM_WINDOWS_CUI)
         process->idle_event = create_event( NULL, empty_str, 0, 1, 0, NULL );
+#ifdef __OpenBSD__
+    /* the client sets its own PEB flag; a write by the server would only
+     * happen after the reply (write_process_memory_apc) */
+    reply->debugged = (process->debug_obj != NULL);
+#else
     if (process->debug_obj) set_process_debug_flag( process, 1 );
+#endif
     reply->suspend = (current->suspend || process->suspend);
 }
 
@@ -1600,6 +1609,23 @@ DECL_HANDLER(get_process_vm_counters)
             procstat_close( procstat );
         }
         else set_error( STATUS_ACCESS_DENIED );
+#elif defined(__OpenBSD__)
+        int mib[] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, process->unix_pid, sizeof(struct kinfo_proc), 1 };
+        struct kinfo_proc kp;
+        size_t len = sizeof(kp);
+        mem_size_t page = getpagesize();
+
+        if (!sysctl( mib, ARRAY_SIZE(mib), &kp, &len, NULL, 0 ) && len == sizeof(kp))
+        {
+            /* as in ntdll fill_vm_counters() */
+            reply->virtual_size = ((mem_size_t)kp.p_vm_tsize + kp.p_vm_dsize + kp.p_vm_ssize) * page;
+            reply->peak_virtual_size = reply->virtual_size;
+            reply->working_set_size = kp.p_vm_rssize * page;
+            reply->peak_working_set_size = max( kp.p_uru_maxrss * 1024, reply->working_set_size );
+            reply->pagefile_usage = ((mem_size_t)kp.p_vm_dsize + kp.p_vm_ssize) * page;
+            reply->peak_pagefile_usage = reply->pagefile_usage;
+        }
+        else set_error( STATUS_ACCESS_DENIED );
 #endif
     }
     else set_error( STATUS_ACCESS_DENIED );
