+#ifdef __OpenBSD__
+/* OpenBSD only lets a process ptrace() its descendants (kern.global_ptrace=0),
+ * and the client processes are not descendants of the server, so a small write
+ * is done by the process itself in a system APC.  It happens asynchronously,
+ * when a thread of the process next handles system APCs; a suspended process
+ * (debugger_attach, debugger_detach) handles it before it resumes. */
+static int write_process_memory_apc( struct process *process, client_ptr_t ptr, data_size_t size,
+                                     const char *src, data_size_t *written )
+{
+    union apc_call call;
+
+    memset( &call, 0, sizeof(call) );
+    call.write_memory.type = APC_WRITE_MEMORY;
+    call.write_memory.size = size;
+    call.write_memory.addr = ptr;
+    memcpy( call.write_memory.data, src, size );
+    if (!thread_queue_apc( process, NULL, NULL, &call ))
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return 0;
+    }
+    if (written) *written = size;
+    return 1;
+}
+#endif
